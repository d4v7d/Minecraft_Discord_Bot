# Token del bot de Discord (Discord Developer Portal > tu app > Bot > Reset Token)
DISCORD_TOKEN=

# ID del canal de Discord donde se van a mandar los avisos (clic derecho al canal > Copiar ID)
DISCORD_CHANNEL_ID=

# Token de API de exaroton (https://exaroton.com/account/)
EXAROTON_TOKEN=

# ID del servidor de exaroton (usa "npm run list-servers" para encontrarlo)
EXAROTON_SERVER_ID=

# --- Opcional: aviso de "jugando solo" ---
# ID del rol de Discord que se menciona cuando alguien lleva rato jugando solo.
# Si lo dejas vacío, el bot funciona igual pero sin esta función.
DISCORD_MINECRAFT_ROLE_ID=

# Minutos que debe estar solo un jugador antes de avisar (por defecto 10 si lo dejas vacío)
SOLO_ALERT_MINUTES=10
